---
import manifest from "../../public/cv/resume-manifest.json";
import type { Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const isChinese = locale === "zh";
const languages = ["en", "zh"] as const;
const labels = {
  zh: { title: "中文简历", language: "zh-CN", filename: "ZhihuaWang_cv_cn.pdf" },
  en: { title: "English CV", language: "en", filename: "ZhihuaWang_cv_en.pdf" }
};
---

<div class="resume-downloads">
  <nav class="resume-languages" aria-label={isChinese ? "简历语言" : "CV languages"}>
    {languages.map((language) => <a href={`#resume-${language}`} lang={labels[language].language}>{labels[language].title}</a>)}
  </nav>
  {languages.map((language, index) => {
    const resume = manifest.resumes[language];
    const url = `${resume.path}?v=${resume.sha256.slice(0, 12)}`;
    return (
      <section id={`resume-${language}`} class="resume-panel" aria-labelledby={`resume-title-${language}`}>
        <header class="resume-panel-header">
          <div>
            <h2 id={`resume-title-${language}`} lang={labels[language].language}>{labels[language].title}</h2>
            <p class="resume-meta">
              {isChinese ? "最近更新：" : "Last updated: "}<time datetime={resume.updatedDate}>{resume.updatedDate.replaceAll("-", ".")}</time>
              <span aria-hidden="true"> · </span>PDF · {resume.pageCount} {isChinese ? "页" : resume.pageCount === 1 ? "page" : "pages"}
            </p>
          </div>
          <div class="resume-actions">
            <a class="button primary" href={url} target="_blank" rel="noopener noreferrer">{isChinese ? "新窗口打开" : "Open PDF"}</a>
            <a class="button ghost" href={url} download={labels[language].filename}>{isChinese ? "下载 PDF" : "Download PDF"}</a>
          </div>
        </header>
        <iframe class="resume-preview" src={`${url}#view=FitH`} title={`${labels[language].title} PDF`} loading={index === 0 ? "eager" : "lazy"}></iframe>
        <p class="resume-help">{isChinese ? "若浏览器无法显示预览，可点击上方按钮打开或下载。" : "If the preview is unavailable, use the buttons above to open or download the PDF."}</p>
      </section>
    );
  })}
</div>

<style>
  .resume-downloads { display: grid; gap: 28px; margin-bottom: 28px; }
  .resume-languages { display: flex; gap: 18px; flex-wrap: wrap; }
  .resume-languages a { font-size: 14px; }
  .resume-panel { min-width: 0; }
  .resume-panel-header { display: flex; align-items: center; justify-content: space-between; gap: 15px; margin-bottom: 14px; flex-wrap: wrap; }
  .resume-panel h2 { font-size: 21px; margin: 0 0 5px; }
  .resume-meta { color: var(--muted); font-size: 13px; margin: 0; }
  .resume-actions { display: flex; flex-wrap: wrap; gap: 16px; }
  .resume-actions .button { padding: 0; border: 0; font-size: 14px; }
  .resume-actions .button:hover { text-decoration: underline; }
  .resume-preview { width: 100%; height: 1050px; display: block; border: 1px solid var(--line); background: #fff; }
  .resume-help { margin: 10px 0 0; font-size: 13px; color: var(--muted); }
  @media (max-width: 680px) { .resume-preview { height: 650px; } }
</style>
