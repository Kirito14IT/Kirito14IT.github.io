---
import BrandIcon from "@components/BrandIcon.astro";

const { links, variant = "default" } = Astro.props as {
  links: Array<{ label: string; url: string }>;
  variant?: "default" | "publication" | "platform";
};

const platforms: Record<string, { name: string; label: string; order: number }> = {
  "arxiv.org": { name: "arxiv", label: "arXiv", order: 0 },
  "github.com": { name: "github", label: "GitHub", order: 1 },
  "huggingface.co": { name: "huggingface", label: "Hugging Face", order: 2 }
};

function getPlatform(url: string) {
  try {
    const hostname = new URL(url).hostname.toLowerCase().replace(/^www\./, "");
    return platforms[hostname];
  } catch {
    return undefined;
  }
}

const orderedLinks = variant === "default" ? links : [...links].sort((left, right) =>
  (getPlatform(left.url)?.order ?? 3) - (getPlatform(right.url)?.order ?? 3)
);
---

<div class:list={["inline-links", "resource-links", { "resource-links--publication": variant === "publication" }]}>
  {orderedLinks.map((link) => {
    const platform = variant === "publication" || variant === "platform" ? getPlatform(link.url) : undefined;
    return (
      <>
      <a class:list={{ "publication-resource-link": variant === "publication", "platform-resource-link": variant === "platform" && Boolean(platform) }} href={link.url} target="_blank" rel="noopener noreferrer">
        {platform && <BrandIcon name={platform.name} size={16} class="resource-link-icon" />}
        <span>{platform?.label ?? link.label}{(variant === "default" || (variant === "platform" && !platform)) && " ↗"}</span>
      </a>
      {platform?.name === "huggingface" && <slot name="after-huggingface" />}
      </>
    );
  })}
</div>

<style>
  .resource-links { align-items: center; }

  .publication-resource-link,
  .platform-resource-link {
    align-items: center;
    gap: 5px;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .publication-resource-link span,
  .platform-resource-link span {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
</style>
