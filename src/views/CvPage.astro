---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import LearningMap from "@components/LearningMap.astro";
import ServiceList from "@components/ServiceList.astro";
import { getCvData } from "@data/cv";
import { getUi, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const { education, experiences, publications, awards, skills, services } = getCvData(locale);
const copy = getUi(locale);
---

<BaseLayout locale={locale} title={locale === "zh" ? "个人简历 | Krico" : "CV | Krico"}>
  <header class="page-header">
    <p class="eyebrow">{copy.cv.eyebrow}</p>
    <h1>{copy.cv.title}</h1>
    <p>{copy.cv.intro}</p>
  </header>

  <Section title={copy.cv.education}>
    <Timeline items={education.map((item) => ({ ...item, title: item.degree, organization: `${item.institution} · ${item.school}`, bullets: item.details }))} />
  </Section>

  <Section title={copy.cv.experience}><Timeline items={experiences} /></Section>

  <Section title={copy.cv.publications}>
    <div class="publication-list">
      {publications.map((item) => (
        <article class="publication-card">
          <div>
            <h3>
              {item.url ? <a class="publication-title-link" href={item.url} target="_blank" rel="noopener noreferrer">{item.title}</a> : item.title}
            </h3>
            <p class="muted">{item.role} · {item.status} · {item.year}</p>
            {item.ratings && <div class="rating-pills">{item.ratings.map((rating) => <span>{rating}</span>)}</div>}
          </div>
          <div class="tag-list">{item.tags.map((tag) => <span>{tag}</span>)}</div>
          {item.frameworkImage && (
            <figure class="framework-preview">
              <img src={item.frameworkImage} alt={item.frameworkAlt} loading="lazy" />
              <figcaption>{item.frameworkCaption || copy.publication.framework}</figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
  </Section>

  <Section title={copy.cv.awards}>
    <div class="glass-card">
      <ul class="clean-list">
        {awards.map((award) => typeof award === "string" ? <li>{award}</li> : <li set:html={award.html} />)}
      </ul>
    </div>
  </Section>

  <Section title={copy.cv.services}><ServiceList items={services} locale={locale} /></Section>

  <Section title={copy.cv.skills}>
    <div class="skill-groups glass-card">
      {skills.map((group) => (
        <section><h3>{group.group}</h3><div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div></section>
      ))}
    </div>
  </Section>

  <Section title={copy.cv.learning}><LearningMap locale={locale} /></Section>
</BaseLayout>
