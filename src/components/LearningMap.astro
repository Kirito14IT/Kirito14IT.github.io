---
import { getCvData } from "@data/cv";
import type { Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const { learningProgress } = getCvData(locale);
---

<div class="learning-grid">
  {learningProgress.map((item) => (
    <article class="learning-card" style={`--value: ${item.percent}`}>
      <div class="learning-card-head">
        <h3>{item.area}</h3>
        <strong>{item.percent}%</strong>
      </div>
      <div class="progress-track" aria-label={locale === "zh" ? `${item.area}学习进度 ${item.percent}%` : `${item.area} learning progress ${item.percent} percent`}>
        <span class="progress-fill"></span>
      </div>
      <p>{item.summary}</p>
    </article>
  ))}
</div>
