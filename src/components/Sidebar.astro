---
import AcmerLogo from "@components/AcmerLogo.astro";
import { getProfile } from "@data/profile";
import { getUi, localizedPath, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const profile = getProfile(locale);
const copy = getUi(locale);
const contactIcons = [
  "M3 5h18v14H3z M3 5l9 7 9-7",
  "M9 19c-4 1-4-2-6-2m12 5v-4c0-1 .1-1.4-.5-2 4-.5 6.5-2 6.5-6a5 5 0 0 0-1.5-3.5 5 5 0 0 0-.1-3.5S18 2.5 15 4a13 13 0 0 0-6 0C6 2.5 4.6 3 4.6 3a5 5 0 0 0-.1 3.5A5 5 0 0 0 3 10c0 4 2.5 5.5 6.5 6-.6.6-.5 1.4-.5 2v4",
  "M2 8l10-5 10 5-10 5-10-5z M6 10v6c4 3 8 3 12 0v-6 M22 8v7",
  "M14 3v12a4 4 0 1 1-4-4 M14 3c1 4 3 6 7 6",
  "M3 4h18v16H3z M7 8h4 M7 12h4 M15 8v8 M7 16h4"
];
---

<aside class="sidebar" aria-label={locale === "zh" ? "个人信息" : "Profile"}>
  <a class="profile-card" data-profile-card href={localizedPath(locale, "/")} aria-label={`${profile.name} ${copy.nav.home}`}>
    <img class="avatar" src={profile.avatarUrl} alt={`${profile.name} avatar`} width="140" height="140" />
    <div class="profile-identity">
      <h1>{profile.name}</h1>
      <p>{profile.legalName}</p>
    </div>
    <AcmerLogo />
  </a>
  <div class="sidebar-details">
    <p>{profile.institution}</p>
    <p class="sidebar-location">{profile.location}</p>
  </div>
  <div class="sidebar-contacts">
    <a class="sidebar-contact" href={localizedPath(locale, "/cv/")}>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3h10l4 4v14H5z M14 3v5h5 M8 12h8 M8 16h6" /></svg>
      <span>{copy.nav.cv}</span>
    </a>
    {profile.links.map((link, index) => (
      <a class="sidebar-contact" href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel={link.url.startsWith("http") ? "noopener noreferrer" : undefined} title={link.displayUrl || link.label}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={contactIcons[index]} /></svg>
        <span>{link.label}</span>
      </a>
    ))}
  </div>
</aside>
