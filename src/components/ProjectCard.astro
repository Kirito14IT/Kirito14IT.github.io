---
import { getUi, type Locale } from "@i18n/index";

const { item, href, locale } = Astro.props as { item: any; href: string; locale: Locale };
const copy = getUi(locale);
---

<a class="project-card" href={href}>
  <div class="project-glow" aria-hidden="true"></div>
  <div class="card-topline">
    <span>{item.data?.date ? item.data.date.getFullYear() : copy.projectsPage.project}</span>
    {item.data?.featured && <strong>{copy.projectsPage.featured}</strong>}
  </div>
  <h3>{item.data?.title || item.title}</h3>
  <p>{item.data?.summary || item.summary}</p>
  <div class="tag-list">
    {(item.data?.tags || item.tags || []).map((tag: string) => <span>{tag}</span>)}
  </div>
</a>
