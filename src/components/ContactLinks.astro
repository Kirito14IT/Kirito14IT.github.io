---
import { getProfile } from "@data/profile";
import { getUi, type Locale } from "@i18n/index";

const { id, locale } = Astro.props as { id?: string; locale: Locale };
const profile = getProfile(locale);
const copy = getUi(locale);
---

<section id={id} class="contact-panel glass-card">
  <div>
    <p class="eyebrow">{copy.contact.eyebrow}</p>
    <h3>{copy.contact.title}</h3>
    <p>{profile.contactNote}</p>
  </div>

  <div class="direct-link-list">
    {profile.links.map((link) => (
      <a class={link.url.includes("scholar.google.com") ? "scholar-link" : undefined} href={link.url} target={link.url.startsWith("http") ? "_blank" : undefined} rel="noopener noreferrer">
        <strong>{link.label}</strong>
        <span>{link.displayUrl || link.url}</span>
      </a>
    ))}
  </div>

  <div class="representative-links">
    {profile.representativeLinks.map((link) => (
      <a class={link.url.includes("scholar.google.com") ? "scholar-link" : undefined} href={link.url} target="_blank" rel="noopener noreferrer">
        <span>{link.label}</span>
        <code>{link.displayUrl}</code>
      </a>
    ))}
  </div>
</section>
