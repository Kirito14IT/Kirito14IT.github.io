---
import BaseLayout from "@layouts/BaseLayout.astro";
import ServiceList from "@components/ServiceList.astro";
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import Education from "@components/Education.astro";
import PublicationCard from "@components/PublicationCard.astro";
import AISafetyHotProject from "@components/AISafetyHotProject.astro";
import VisitorMap from "@components/VisitorMap.astro";
import NewsCard from "@components/NewsCard.astro";
import BrandIcon from "@components/BrandIcon.astro";
import { getProfile } from "@data/profile";
import { getCvData } from "@data/cv";
import { getUi, localizedPath, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const profile = getProfile(locale);
const { news, workExperiences, experiences, publications, awards, services } = getCvData(locale);
const copy = getUi(locale);
const [fvl, teai] = profile.affiliations;
const researchPrefix = locale === "zh" ? "我的研究兴趣包括" : "My research interests include";

const homeJumpLinks = [
  { label: copy.homeJump.about, href: "#about" },
  { label: copy.homeJump.news, href: "#news" },
  { label: copy.homeJump.publications, href: "#publications" },
  { label: copy.homeJump.projects, href: "#projects" },
  { label: copy.homeJump.education, href: "#education" },
  { label: copy.homeJump.work, href: "#work-experience" },
  { label: copy.homeJump.research, href: "#research-experience" },
  { label: copy.homeJump.awards, href: "#awards-skills" },
  { label: copy.homeJump.services, href: "#services" },
  { label: copy.homeJump.acknowledgements, href: "#acknowledgements" }
];
---

<BaseLayout locale={locale}>
  <nav slot="toolbar" class="quick-jump-nav" aria-label={locale === "zh" ? "主页章节导航" : "Homepage section shortcuts"}>
    {homeJumpLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div id="home" class="anchor-sentinel"></div>

  <Section id="about" title={copy.sections.about} icon="👋">
    <div class="about-copy">
      {locale === "zh" ? (
        <>
          <p>Hello! 我是<strong>王志华</strong>，是<a href={profile.incomingInstitutionUrl}><BrandIcon name="fudan" size={17} class="about-affiliation-logo" />复旦大学</a> <a href={fvl.url} title={fvl.title}>FVL</a>（由<a href={profile.labHeadUrl}><strong>姜育刚教授（复旦大学副校长）</strong></a>领导）与 <a href={teai.url} title={teai.title}><BrandIcon name="teai" size={17} class="about-affiliation-logo" />TEAI</a> 的<strong>准硕士生</strong>，师从<a href={profile.advisorUrl}><strong>马兴军教授</strong></a>。我目前在上海理工大学光电信息与计算机工程学院（<a href={profile.institutionUrl}><BrandIcon name="usst" size={17} class="about-affiliation-logo" />USST</a>）攻读<strong>计算机科学与技术学士学位</strong>（<em>2023–2027</em>）。我的开源项目累计获得约 <span class="about-stat-badge"><BrandIcon name="github" size={15} />2.5k GitHub Stars</span>，并获 <strong class="about-award">ACM <BrandIcon name="icpc" size={24} width={41} />银奖</strong>。</p>
          <p>目前，我在<span class="company-badge" aria-hidden="true"><BrandIcon name="gass" size={20} width={116} /></span>公安部第三研究所（<a href="https://www.gass.ac.cn/gass/index.html" title="公安部第三研究所">TRIMPS</a>）担任 <strong>LLM 研究实习生</strong>，由 <strong>Nan Li</strong> 指导，主要研究 <strong>Web Agent 与 LLM 安全评测基准</strong>。我还与<a href="https://www.deakin.edu.au"><BrandIcon name="deakin" size={17} class="about-affiliation-logo" />迪肯大学</a>博士生 <a href="https://github.com/wuyoscar">Yutao Wu</a>、在<span class="company-badge" aria-hidden="true"><BrandIcon name="ant" size={20} width={60} /></span>（<a href="https://www.antgroup.com" title="蚂蚁集团">Ant Group</a>）实习的博士生 <a href="https://yunhao-feng.github.io">Yunhao Feng</a> 合作，关注<strong>多智能体系统、Coding Agent 与可信 AI</strong>。</p>
        </>
      ) : (
        <>
          <p>Hello! I am <strong>Zhihua Wang</strong>, an <strong>incoming master's student</strong> at <a href={profile.incomingInstitutionUrl}><BrandIcon name="fudan" size={17} class="about-affiliation-logo" />Fudan University's</a> <a href={fvl.url} title={fvl.title}>FVL</a>, led by <a href={profile.labHeadUrl}><strong>Prof. Yu-Gang Jiang (Vice President, Fudan University)</strong></a>, and <a href={teai.url} title={teai.title}><BrandIcon name="teai" size={17} class="about-affiliation-logo" />TEAI</a>. I will be advised by <a href={profile.advisorUrl}><strong>Prof. Xingjun Ma</strong></a>. I am pursuing a <strong>bachelor's degree in Computer Science and Technology</strong> at the School of Optical-Electrical and Computer Engineering, University of Shanghai for Science and Technology (<a href={profile.institutionUrl}><BrandIcon name="usst" size={17} class="about-affiliation-logo" />USST</a>) (<em>2023–2027</em>). My open-source projects have received approximately <span class="about-stat-badge"><BrandIcon name="github" size={15} />2.5k GitHub Stars</span>, and I won an <strong class="about-award">ACM <BrandIcon name="icpc" size={24} width={41} />silver medal</strong>.</p>
          <p>I am currently an <strong>LLM research intern</strong> at the <span class="company-badge" aria-hidden="true"><BrandIcon name="gass" size={20} width={116} /></span> Third Research Institute of the Ministry of Public Security (<a href="https://www.gass.ac.cn/gass/index.html" title="Third Research Institute of the Ministry of Public Security">TRIMPS</a>), guided by <strong>Nan Li</strong>, working on <strong>Web Agent and LLM safety evaluation benchmarks</strong>. I also collaborate with <a href="https://github.com/wuyoscar">Yutao Wu</a>, a PhD student at <a href="https://www.deakin.edu.au"><BrandIcon name="deakin" size={17} class="about-affiliation-logo" />Deakin University</a>, and <a href="https://yunhao-feng.github.io">Yunhao Feng</a>, a PhD student interning at <span class="company-badge" aria-hidden="true"><BrandIcon name="ant" size={20} width={60} /></span> (<a href="https://www.antgroup.com" title="Ant Group">Ant Group</a>), on <strong>multi-agent systems, coding agents, and trustworthy AI</strong>.</p>
        </>
      )}
      <p>{researchPrefix}<strong>{profile.researchInterests.slice(researchPrefix.length)}</strong> 🙂（：</p>
      <aside class="internship-callout" aria-label={profile.internshipSearch.title}>
        <h3><span aria-hidden="true">💼 </span>{profile.internshipSearch.title}</h3>
        {locale === "zh" ? (
          <p>正在寻找<strong>基座大模型、Coding Agent、智能体后训练、Agent RL 和大模型评测</strong>相关实习。{profile.contactNote}欢迎通过邮箱联系：<strong>{profile.email}</strong>。</p>
        ) : (
          <p>I am seeking internships in <strong>foundation models, coding agents, agent post-training, Agent RL, and LLM evaluation</strong>. {profile.contactNote} Contact me at <strong>{profile.email}</strong>.</p>
        )}
        <p><span aria-hidden="true">📄 </span>{locale === "zh" ? <>附上我的<a href={localizedPath(locale, "/cv/")}>简历</a>，欢迎联系。</> : <>Here is my <a href={localizedPath(locale, "/cv/")}>CV</a>. Please feel free to get in touch.</>} ：）</p>
      </aside>
    </div>
  </Section>

  <Section id="news" title={copy.sections.news} icon="🔥">
    <div class="news-scroll" role="region" aria-label={copy.sections.news} tabindex="0">
      <div class="news-list">
        {news.map((item, index) => <NewsCard item={item} locale={locale} id={`news-media-${index}`} />)}
      </div>
    </div>
  </Section>

  <Section id="publications" title={copy.sections.publications} icon="📝">
    <div class="publication-list publication-list--home">
      {publications.map((item) => (
        <PublicationCard
          item={{
            ...item,
            authors: item.homepageAuthors ?? item.authors,
            status: item.homepageStatus ?? item.status,
            ratings: item.homepageRatings ?? item.ratings
          }}
          locale={locale}
          variant="home"
        />
      ))}
    </div>
  </Section>

  <Section id="projects" title={copy.sections.projects} icon="🚀" headingHref={localizedPath(locale, "/projects/")}>
    <AISafetyHotProject locale={locale} />
  </Section>

  <Education locale={locale} compact />

  <Section id="work-experience" title={copy.sections.workExperience} icon="💼">
    <Timeline items={workExperiences} />
  </Section>

  <Section id="research-experience" title={copy.sections.researchExperience} icon="🔬">
    <Timeline items={experiences} collapsible />
  </Section>

  <Section id="awards-skills" title={copy.sections.awards} icon="🏆">
    <ul class="clean-list awards-list">
      {awards.map((award) => typeof award === "string" ? <li>{award}</li> : <li set:html={award.html} />)}
    </ul>
  </Section>

  <Section id="services" title={copy.sections.services} icon="🤝">
    <ServiceList items={services} locale={locale} />
  </Section>
  <Section id="acknowledgements" title={copy.sections.acknowledgements} icon="🙏">
    <p>{locale === "zh" ? "感谢各位老师、导师和合作者的指导与支持，也感谢一路同行的学长学姐和朋友。" : "I thank my teachers, mentors, and collaborators for their guidance and support, and my senior peers and friends for accompanying me along the way."}</p>
  </Section>
  <VisitorMap locale={locale} />
</BaseLayout>
