---
import { getProfile } from "@data/profile";
import { getUi, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const profile = getProfile(locale);
const copy = getUi(locale);
const dynamicCopy = {
  unavailable: copy.contribution.unavailable,
  openLatest: copy.contribution.openLatest,
  unavailableNote: copy.contribution.unavailableNote,
  summary: copy.contribution.summary,
  activeDays: copy.contribution.activeDays,
  cachedNote: copy.contribution.cachedNote,
  dayTitle: copy.contribution.dayTitle
};
---

<section class="section-stack">
  <div class="section-heading-row">
    <div class="section-heading">
      <p>{copy.contribution.eyebrow}</p>
      <h2>{copy.contribution.title}</h2>
    </div>
    <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">{copy.contribution.open}</a>
  </div>

  <article
    class="contrib-card"
    data-contrib-root
    data-username={profile.githubUsername}
    data-locale={locale}
    data-copy={JSON.stringify(dynamicCopy)}
  >
    <div class="contrib-header">
      <div>
        <p class="muted">{copy.contribution.last12Months}</p>
        <strong data-contrib-summary>{copy.contribution.loading}</strong>
      </div>
      <p class="muted" data-contrib-total>{copy.contribution.syncing}</p>
    </div>
    <div class="contrib-months" data-contrib-months></div>
    <div class="contrib-body">
      <div class="contrib-axis" aria-hidden="true">
        {copy.contribution.weekdays.map((day) => <span>{day}</span>)}
      </div>
      <div class="contrib-columns" data-contrib-columns role="img" aria-label={copy.contribution.calendarLabel}></div>
    </div>
    <div class="contrib-legend" aria-hidden="true">
      <span>{copy.contribution.less}</span>
      <span class="contrib-cell level-0"></span>
      <span class="contrib-cell level-1"></span>
      <span class="contrib-cell level-2"></span>
      <span class="contrib-cell level-3"></span>
      <span class="contrib-cell level-4"></span>
      <span>{copy.contribution.more}</span>
    </div>
    <p class="muted" data-contrib-note>{copy.contribution.initialNote}</p>
  </article>
</section>

<script>
  const contributionRoots = document.querySelectorAll<HTMLElement>("[data-contrib-root]");

  const toUtcDate = (value) => {
    const date = new Date(`${value}T00:00:00Z`);
    return new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth(), date.getUTCDate()));
  };

  const addUtcDays = (value, days) => {
    const next = new Date(value);
    next.setUTCDate(next.getUTCDate() + days);
    return next;
  };

  const formatDay = (value) => value.toISOString().slice(0, 10);
  const fillTemplate = (template, values) =>
    Object.entries(values).reduce((output, [key, value]) => output.replaceAll(`{${key}}`, String(value)), template);

  const buildWeeks = (contributions, monthFormatter) => {
    if (!Array.isArray(contributions) || contributions.length === 0) return [];
    const sorted = [...contributions].sort((a, b) => a.date.localeCompare(b.date));
    const counts = new Map(sorted.map((item) => [item.date, item]));
    const firstDate = toUtcDate(sorted[0].date);
    const lastDate = toUtcDate(sorted[sorted.length - 1].date);
    const calendarStart = addUtcDays(firstDate, -firstDate.getUTCDay());
    const calendarEnd = addUtcDays(lastDate, 6 - lastDate.getUTCDay());
    const weeks = [];
    let cursor = calendarStart;
    let buffer = [];

    while (cursor <= calendarEnd) {
      const date = formatDay(cursor);
      const entry = counts.get(date) || { date, count: 0, level: 0 };
      const inRange = date >= sorted[0].date && date <= sorted[sorted.length - 1].date;
      buffer.push({ date, count: entry.count || 0, level: entry.level || 0, inRange });

      if (buffer.length === 7) {
        const labelSource =
          buffer.find((day) => day.inRange && toUtcDate(day.date).getUTCDate() === 1) ||
          (weeks.length === 0 ? buffer.find((day) => day.inRange) : undefined);
        weeks.push({ label: labelSource ? monthFormatter.format(toUtcDate(labelSource.date)) : "", days: buffer });
        buffer = [];
      }
      cursor = addUtcDays(cursor, 1);
    }
    return weeks;
  };

  const renderGraph = (root, payload) => {
    const locale = root.dataset.locale === "zh" ? "zh" : "en";
    const dateLocale = locale === "zh" ? "zh-CN" : "en-US";
    const copy = JSON.parse(root.dataset.copy || "{}");
    const monthFormatter = new Intl.DateTimeFormat(dateLocale, {
      month: locale === "zh" ? "numeric" : "short",
      timeZone: "UTC"
    });
    const numberFormatter = new Intl.NumberFormat(dateLocale);
    const summary = root.querySelector("[data-contrib-summary]");
    const total = root.querySelector("[data-contrib-total]");
    const months = root.querySelector<HTMLElement>("[data-contrib-months]");
    const columns = root.querySelector("[data-contrib-columns]");
    const note = root.querySelector("[data-contrib-note]");
    const contributions = payload?.contributions || [];
    const weeks = buildWeeks(contributions, monthFormatter);
    const totalLastYear = payload?.total?.lastYear || 0;
    const activeDays = contributions.filter((item) => (item.count || 0) > 0).length;

    if (!weeks.length || !months || !columns) {
      if (summary) summary.textContent = copy.unavailable;
      if (total) total.textContent = copy.openLatest;
      if (note) note.textContent = copy.unavailableNote;
      return;
    }

    months.style.setProperty("--weeks", String(weeks.length));
    months.innerHTML = "<span></span>";
    columns.innerHTML = "";

    weeks.forEach((week) => {
      const label = document.createElement("span");
      label.textContent = week.label;
      months.appendChild(label);

      const column = document.createElement("div");
      column.className = "contrib-week";
      week.days.forEach((day) => {
        const cell = document.createElement("span");
        cell.className = `contrib-cell level-${day.level}${day.inRange ? "" : " outside"}`;
        cell.title = fillTemplate(copy.dayTitle, {
          date: day.date,
          count: numberFormatter.format(day.count),
          suffix: day.count === 1 ? "" : "s"
        });
        column.appendChild(cell);
      });
      columns.appendChild(column);
    });

    if (summary) summary.textContent = fillTemplate(copy.summary, { count: numberFormatter.format(totalLastYear) });
    if (total) total.textContent = fillTemplate(copy.activeDays, { count: numberFormatter.format(activeDays) });
    if (note) note.textContent = copy.cachedNote;
  };

  contributionRoots.forEach((root) => {
    const username = root.getAttribute("data-username");
    if (!username) return;
    fetch(`https://github-contributions-api.jogruber.de/v4/${encodeURIComponent(username)}?y=last`)
      .then((response) => {
        if (!response.ok) throw new Error(String(response.status));
        return response.json();
      })
      .then((payload) => renderGraph(root, payload))
      .catch(() => renderGraph(root, null));
  });
</script>
