---
const { item, href } = Astro.props;
---

<a class="project-card" href={href}>
  <div class="project-glow" aria-hidden="true"></div>
  <div class="card-topline">
    <span>{item.data?.date ? item.data.date.getFullYear() : "Project"}</span>
    {item.data?.featured && <strong>Featured</strong>}
  </div>
  <h3>{item.data?.title || item.title}</h3>
  <p>{item.data?.summary || item.summary}</p>
  <div class="tag-list">
    {(item.data?.tags || item.tags || []).map((tag: string) => <span>{tag}</span>)}
  </div>
</a>
