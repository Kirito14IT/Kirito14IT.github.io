---
import BaseLayout from "@layouts/BaseLayout.astro";
import ServiceList from "@components/ServiceList.astro";
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import Education from "@components/Education.astro";
import PublicationCard from "@components/PublicationCard.astro";
import AISafetyHotProject from "@components/AISafetyHotProject.astro";
import VisitorMap from "@components/VisitorMap.astro";
import NewsCard from "@components/NewsCard.astro";
import { getProfile } from "@data/profile";
import { getCvData } from "@data/cv";
import { getUi, localizedPath, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const profile = getProfile(locale);
const { news, workExperiences, experiences, publications, awards, services } = getCvData(locale);
const copy = getUi(locale);
const [fvl, teai] = profile.affiliations;
const emailLabel = locale === "zh" ? "邮件" : "email";
const [contactBeforeEmail, contactAfterEmail] = profile.contactNote.split(emailLabel);

const homeJumpLinks = [
  { label: copy.homeJump.about, href: "#about" },
  { label: copy.homeJump.news, href: "#news" },
  { label: copy.homeJump.publications, href: "#publications" },
  { label: copy.homeJump.education, href: "#education" },
  { label: copy.homeJump.projects, href: "#projects" },
  { label: copy.homeJump.research, href: "#research-experience" },
  { label: copy.homeJump.awards, href: "#awards-skills" },
  { label: copy.homeJump.work, href: "#work-experience" },
  { label: copy.homeJump.services, href: "#services" }
];
---

<BaseLayout locale={locale}>
  <nav slot="toolbar" class="quick-jump-nav" aria-label={locale === "zh" ? "主页章节导航" : "Homepage section shortcuts"}>
    {homeJumpLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <div id="home" class="anchor-sentinel"></div>

  <Section id="about" title={copy.sections.about} icon="👋">
    <div class="about-copy">
      {locale === "zh" ? (
        <p>我是<a href={profile.institutionUrl}>上海理工大学</a>计算机科学与技术专业大四本科生，将于 2027 年进入<a href={profile.incomingInstitutionUrl}>复旦大学</a>攻读硕士，导师为<a href={profile.advisorUrl}>{profile.advisorName}</a>老师。目前在<a href={profile.labHeadUrl}>姜育刚</a>老师负责的<a href={fvl.url} title={fvl.title}><img class="about-affiliation-logo" src={fvl.logo} alt="" width="18" height="18" />复旦大学视觉与学习实验室（FVL）</a>及<a href={teai.url} title={teai.title}><img class="about-affiliation-logo" src={teai.logo} alt="" width="18" height="18" />可信具身智能研究院（TEAI）</a>进行科研实习。研究兴趣包括基座大模型、Coding Agent、智能体后训练与强化学习，以及可信人工智能。</p>
      ) : (
        <p>I am a senior undergraduate in Computer Science and Technology at <a href={profile.institutionUrl} title={profile.institution}>USST</a> and an incoming M.Sc. student at <a href={profile.incomingInstitutionUrl}>Fudan University</a> (2027), advised by <a href={profile.advisorUrl}>{profile.advisorName}</a>. I am currently a research intern at <a href={fvl.url} title={fvl.title}><img class="about-affiliation-logo" src={fvl.logo} alt="" width="18" height="18" />Fudan FVL</a>, led by <a href={profile.labHeadUrl}>Yu-Gang Jiang</a>, and <a href={teai.url} title={teai.title}><img class="about-affiliation-logo" src={teai.logo} alt="" width="18" height="18" />TEAI</a>. My research interests include foundation models, coding agents, agent post-training and reinforcement learning, and trustworthy AI.</p>
      )}
      <p>{profile.internshipSearch.description}</p>
      <p>{contactBeforeEmail}<a href={`mailto:${profile.email}`}>{emailLabel}</a>{contactAfterEmail}</p>
    </div>
  </Section>

  <Section id="news" title={copy.sections.news} icon="📰">
    <div class="news-scroll" role="region" aria-label={copy.sections.news} tabindex="0">
      <div class="news-list">
        {news.map((item, index) => <NewsCard item={item} locale={locale} id={`news-media-${index}`} />)}
      </div>
    </div>
  </Section>

  <Section id="publications" title={copy.sections.publications} icon="📝">
    <p class="publication-author-legend muted">* {copy.publication.coFirst} · † {copy.publication.corresponding}</p>
    <div class="publication-list publication-list--home">
      {publications.map((item) => (
        <PublicationCard
          item={{
            ...item,
            authors: item.homepageAuthors ?? item.authors,
            status: item.homepageStatus ?? item.status,
            ratings: item.homepageRatings ?? item.ratings
          }}
          locale={locale}
        />
      ))}
    </div>
  </Section>

  <Education locale={locale} compact />

  <Section id="projects" title={copy.sections.projects} icon="🛠️" headingHref={localizedPath(locale, "/projects/")}>
    <AISafetyHotProject locale={locale} />
  </Section>

  <Section id="research-experience" title={copy.sections.researchExperience} icon="🔬">
    <Timeline items={experiences} collapsible />
  </Section>

  <Section id="awards-skills" title={copy.sections.awards} icon="🏆">
    <ul class="clean-list awards-list">
      {awards.map((award) => typeof award === "string" ? <li>{award}</li> : <li set:html={award.html} />)}
    </ul>
  </Section>

  <Section id="work-experience" title={copy.sections.workExperience} icon="💼">
    <Timeline items={workExperiences} />
  </Section>

  <Section id="services" title={copy.sections.services} icon="🤝">
    <ServiceList items={services} locale={locale} />
  </Section>
  <VisitorMap locale={locale} />
</BaseLayout>