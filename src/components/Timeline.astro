---
import RepoStars from "@components/RepoStars.astro";
import type { TimelineItem } from "@data/cv";

interface Props {
  items: TimelineItem[];
  collapsible?: boolean;
}

const { items, collapsible = false } = Astro.props;
---

<div class="timeline">
  {items.map((item) => {
    const Item = collapsible ? "details" : "article";
    return (
    <Item class:list={["timeline-item", { "timeline-disclosure": collapsible }]}>
      {collapsible ? (
        <summary class="timeline-summary">
          <span class="timeline-date">{item.period}</span>
          <span class="timeline-summary-text">{item.summary ?? item.title}</span>
        </summary>
      ) : <div class="timeline-date">{item.period}</div>}
      <div class="timeline-card">
        <h3>
          {item.titleUrl ? (
            <a class="timeline-title-link" href={item.titleUrl} target="_blank" rel="noopener noreferrer">
              {item.title}
            </a>
          ) : (
            item.title
          )}
        </h3>
        {item.starRepos && <RepoStars repos={item.starRepos} />}
        {item.organization && (
          <p class="muted">
            {item.organizationUrl ? (
              <a href={item.organizationUrl} target="_blank" rel="noopener noreferrer">
                {item.organization}
              </a>
            ) : (
              item.organization
            )}
          </p>
        )}
        {item.tags && (
          <div class="tag-list">
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>
        )}
        {item.bullets && (
          <ul>
            {item.bullets.map((bullet) => (
              <li>
                {typeof bullet === "string" ? bullet : <span set:html={bullet.html} />}
              </li>
            ))}
          </ul>
        )}
        {item.links && (
          <div class="inline-links">
            {item.links.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.logo && <img class="inline-link-logo" src={link.logo} alt="" width="22" height="22" loading="lazy" />}
                {link.label}
              </a>
            ))}
          </div>
        )}
      </div>
    </Item>
    );
  })}
</div>
