---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import TypingHero from "@components/TypingHero.astro";
import ContributionGraph from "@components/ContributionGraph.astro";
import ContactLinks from "@components/ContactLinks.astro";
import LearningMap from "@components/LearningMap.astro";
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { profile } from "@data/profile";
import { news, experiences, publications, awards, skills } from "@data/cv";

const allProjects = (await getCollection("projects"))
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 4);

const slugFromId = (id: string) => id.replace(/\.md$/, "");

const homeJumpLinks = [
  { label: "Homepage", href: "#home" },
  { label: "About Me", href: "#about" },
  { label: "News", href: "#news" },
  { label: "Research Experience", href: "#research-experience" },
  { label: "Publications", href: "#publications" },
  { label: "Projects", href: "#projects" },
  { label: "Awards", href: "#awards-skills" }
];
---

<BaseLayout>
  <div id="home" class="anchor-sentinel"></div>
  <nav class="quick-jump-nav" aria-label="Homepage section shortcuts">
    {homeJumpLinks.map((link) => <a href={link.href}>{link.label}</a>)}
  </nav>

  <TypingHero />

  <Section id="about" title="About Me" eyebrow="Profile">
    <div class="glass-card prose-card">
      <p>{profile.bio}</p>
      <p>
        I keep this public homepage focused on research, projects, open-source activity, and reproducible artifacts.
      </p>
      <div class="tag-list">
        {profile.interests.map((interest) => <span>{interest}</span>)}
      </div>
    </div>
  </Section>

  <ContactLinks id="contact" />

  <Section id="news" title="News" eyebrow="Recent updates">
    <div class="news-list">
      {news.map((item) => (
        <article>
          <time>{item.date}</time>
          {item.html ? <p set:html={item.html} /> : <p>{item.text}</p>}
        </article>
      ))}
    </div>
  </Section>

  <Section id="research-experience" title="Selected Research and Experience" eyebrow="Timeline">
    <Timeline items={experiences} />
  </Section>

  <Section id="publications" title="Selected Publications and Manuscripts" eyebrow="Research output">
    <div class="publication-list">
      {publications.map((item) => (
        <article class="publication-card">
          <div>
            <h3>
              {item.url ? (
                <a class="publication-title-link" href={item.url} target="_blank" rel="noopener noreferrer">
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h3>
            <p class="muted">{item.role} · {item.status} · {item.year}</p>
            {item.ratings && (
              <div class="rating-pills">
                {item.ratings.map((rating) => <span>{rating}</span>)}
              </div>
            )}
          </div>
          <div class="tag-list">
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>
          {item.frameworkImage && (
            <figure class="framework-preview">
              <img src={item.frameworkImage} alt={item.frameworkAlt} loading="lazy" />
              <figcaption>{item.frameworkCaption || "Framework overview"}</figcaption>
            </figure>
          )}
        </article>
      ))}
    </div>
  </Section>

  <ContributionGraph />

  <Section id="projects" title="Featured Projects" eyebrow="Builds and artifacts">
    <div class="card-grid">
      {allProjects.map((item) => <ProjectCard item={item} href={`/projects/${slugFromId(item.id)}/`} />)}
    </div>
  </Section>

  <Section id="learning-map" title="Learning Map" eyebrow="Knowledge progress">
    <LearningMap />
  </Section>

  <Section id="awards-skills" title="Awards and Skills" eyebrow="Signals">
    <div class="two-column">
      <div class="glass-card">
        <h3>Selected Honors</h3>
        <ul class="clean-list">
          {awards.map((award) => <li>{award}</li>)}
        </ul>
      </div>
      <div class="glass-card">
        <h3>Skills</h3>
        <div class="skill-groups">
          {skills.map((group) => (
            <section>
              <h4>{group.group}</h4>
              <div class="tag-list">
                {group.items.map((item) => <span>{item}</span>)}
              </div>
            </section>
          ))}
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>
