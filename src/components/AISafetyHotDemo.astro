---
import type { Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const zh = locale === "zh";
const animation = "/media/aisafetyhot/observatory.gif";
const poster = "/media/aisafetyhot/observatory-poster.webp";
---

<figure class="aisafetyhot-demo" data-project-demo>
  <picture>
    <source media="(prefers-reduced-motion: reduce)" srcset={poster} />
    <img
      src={animation}
      data-animation={animation}
      data-poster={poster}
      alt={zh ? "AISafetyHot 原项目演示：材料扫描、三维研究星图与新闻流" : "Original AISafetyHot demo: source scanning, a 3D research graph, and the news stream"}
      width="1000"
      height="694"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <figcaption>
    <span>{zh ? "演示来源：" : "Demo credit: "}<a href="https://github.com/wuyoscar/AISafetyHot/blob/main/assets/observatory.gif" target="_blank" rel="noopener noreferrer">AI Safety HOT · README</a></span>
    <a href={`https://aisafetyhot.com/${zh ? "zh" : "en"}`} target="_blank" rel="noopener noreferrer">{zh ? "打开项目网站 ↗" : "Explore the website ↗"}</a>
  </figcaption>
</figure>

<style>
  .aisafetyhot-demo { margin: 0; }
  .aisafetyhot-demo img { display: block; width: 100%; height: auto; }
  .aisafetyhot-demo figcaption { display: flex; flex-wrap: wrap; gap: 4px 12px; padding-block: 6px; font-size: 11px; color: var(--muted); }
</style>
