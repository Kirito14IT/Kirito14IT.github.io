---
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import { getCvData } from "@data/cv";
import { getUi, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const { education } = getCvData(locale);
const copy = getUi(locale);
const items = education.map((item) => ({
  ...item,
  title: item.degree,
  organization: [item.institution, item.school].filter(Boolean).join(" · "),
  bullets: item.details
}));
---

<Section id="education" title={copy.cv.education}>
  <Timeline items={items} />
</Section>
