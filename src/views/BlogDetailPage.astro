---
import { render } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatNumericDate } from "@i18n/date";
import type { Locale } from "@i18n/index";

const { post, locale } = Astro.props as { post: any; locale: Locale };
const { Content } = await render(post);
---

<BaseLayout locale={locale} title={`${post.data.title} | Carey`} description={post.data.description}>
  <article class="article-page">
    <header class="page-header">
      <h1>{post.data.title}</h1>
      <p class="article-date"><time datetime={post.data.date.toISOString().slice(0, 10)}>{formatNumericDate(post.data.date, { timeZone: "UTC" })}</time></p>
      <p>{post.data.description}</p>
      <div class="tag-list">{post.data.tags.map((tag: string) => <span>{tag}</span>)}</div>
    </header>
    <div class="markdown-body"><Content /></div>
  </article>
</BaseLayout>
