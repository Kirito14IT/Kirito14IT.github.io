<canvas class="neural-field-canvas" data-neural-field aria-hidden="true"></canvas>

<script>
  const neuralCanvases = document.querySelectorAll("[data-neural-field]");
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  neuralCanvases.forEach((canvas) => {
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    const state = {
      width: 0,
      height: 0,
      dpr: 1,
      pointerX: 0,
      pointerY: 0,
      frame: 0,
      nodes: []
    };

    const labels = ["tool", "policy", "risk", "audit", "agent", "human", "sandbox", "trace"];

    const createNodes = () => {
      const total = state.width < 640 ? 42 : 68;
      state.nodes = Array.from({ length: total }, (_, index) => {
        const ring = index % 4;
        const angle = (Math.PI * 2 * index) / total + ring * 0.38;
        const radius = 0.22 + ring * 0.12 + Math.random() * 0.08;
        return {
          angle,
          radius,
          z: Math.random() * 2 - 1,
          pulse: Math.random() * Math.PI * 2,
          label: index % 9 === 0 ? labels[index % labels.length] : ""
        };
      });
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      state.width = rect.width;
      state.height = rect.height;
      state.dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      canvas.width = Math.max(1, Math.floor(rect.width * state.dpr));
      canvas.height = Math.max(1, Math.floor(rect.height * state.dpr));
      ctx.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
      createNodes();
    };

    const project = (node, time) => {
      const pointerTiltX = state.pointerX * 0.42;
      const pointerTiltY = state.pointerY * 0.28;
      const rotation = time * 0.00016 + pointerTiltX;
      const depthSpin = time * 0.00022 + pointerTiltY;
      const x3 = Math.cos(node.angle + rotation) * node.radius;
      const y3 = Math.sin(node.angle + rotation) * node.radius * 0.62 + Math.sin(node.pulse + depthSpin) * 0.08;
      const z3 = node.z * 0.48 + Math.cos(node.angle + depthSpin) * 0.38;
      const scale = 1 / (1.55 - z3 * 0.32);
      const minSide = Math.min(state.width, state.height);
      return {
        x: state.width * 0.62 + x3 * minSide * scale,
        y: state.height * 0.48 + y3 * minSide * scale,
        z: z3,
        scale,
        label: node.label,
        pulse: node.pulse
      };
    };

    const draw = (time) => {
      state.frame = window.requestAnimationFrame(draw);
      ctx.clearRect(0, 0, state.width, state.height);

      const points = state.nodes.map((node) => project(node, reducedMotion ? 0 : time));

      for (let i = 0; i < points.length; i += 1) {
        for (let j = i + 1; j < points.length; j += 1) {
          const a = points[i];
          const b = points[j];
          const dx = a.x - b.x;
          const dy = a.y - b.y;
          const distance = Math.sqrt(dx * dx + dy * dy);
          if (distance > 118) continue;
          const alpha = Math.max(0, 1 - distance / 118) * 0.22;
          ctx.strokeStyle = `rgba(37, 99, 235, ${alpha})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(a.x, a.y);
          ctx.lineTo(b.x, b.y);
          ctx.stroke();
        }
      }

      points
        .sort((a, b) => a.z - b.z)
        .forEach((point, index) => {
          const glow = 2.2 + point.scale * 3.2 + Math.sin(time * 0.002 + point.pulse) * 0.7;
          const hue = index % 3 === 0 ? "37, 99, 235" : index % 3 === 1 ? "8, 145, 178" : "219, 39, 119";
          ctx.fillStyle = `rgba(${hue}, ${0.26 + point.scale * 0.18})`;
          ctx.beginPath();
          ctx.arc(point.x, point.y, glow, 0, Math.PI * 2);
          ctx.fill();

          if (point.label) {
            ctx.font = "700 11px JetBrains Mono, monospace";
            ctx.fillStyle = "rgba(20, 32, 51, 0.46)";
            ctx.fillText(point.label, point.x + 8, point.y - 8);
          }
        });
    };

    const onPointerMove = (event) => {
      const rect = canvas.getBoundingClientRect();
      state.pointerX = ((event.clientX - rect.left) / Math.max(rect.width, 1) - 0.5) * 2;
      state.pointerY = ((event.clientY - rect.top) / Math.max(rect.height, 1) - 0.5) * 2;
    };

    resize();
    window.addEventListener("resize", resize);
    canvas.closest(".hero-panel")?.addEventListener("pointermove", onPointerMove);
    state.frame = window.requestAnimationFrame(draw);
  });
</script>
