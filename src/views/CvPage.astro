---
import BaseLayout from "@layouts/BaseLayout.astro";
import Section from "@components/Section.astro";
import Timeline from "@components/Timeline.astro";
import Education from "@components/Education.astro";
import LearningMap from "@components/LearningMap.astro";
import ServiceList from "@components/ServiceList.astro";
import PublicationCard from "@components/PublicationCard.astro";
import ResumeDownloads from "@components/ResumeDownloads.astro";
import DetailedResume from "@components/DetailedResume.astro";
import { getCvData } from "@data/cv";
import { getUi, type Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const { workExperiences, experiences, publications, awards, skills, services } = getCvData(locale);
const copy = getUi(locale);
---

<BaseLayout locale={locale} title={locale === "zh" ? "个人简历 | Carey" : "CV | Carey"}>
  <header class="page-header">
    <h1>{copy.cv.title}</h1>
    <p>{copy.cv.intro}</p>
  </header>

  <ResumeDownloads locale={locale} />
  <DetailedResume locale={locale} />

  <details class="web-cv">
    <summary>{locale === "zh" ? "展开网页版履历" : "View web CV"}</summary>
    <div class="web-cv-content">
  <Education locale={locale} />

  <Section id="work-experience" title={copy.cv.workExperience}><Timeline items={workExperiences} /></Section>

  <Section title={copy.cv.experience}><Timeline items={experiences} /></Section>

  <Section title={copy.cv.publications}>
    <p class="publication-author-legend muted">* {copy.publication.coFirst} · † {copy.publication.corresponding}</p>
    <div class="publication-list">
      {publications.map((item) => <PublicationCard item={item} locale={locale} />)}
    </div>
  </Section>

  <Section title={copy.cv.awards}>
    <div class="glass-card">
      <ul class="clean-list">
        {awards.map((award) => typeof award === "string" ? <li>{award}</li> : <li set:html={award.html} />)}
      </ul>
    </div>
  </Section>

  <Section title={copy.cv.services}><ServiceList items={services} locale={locale} /></Section>

  <Section title={copy.cv.skills}>
    <div class="skill-groups glass-card">
      {skills.map((group) => (
        <section><h3>{group.group}</h3><div class="tag-list">{group.items.map((item) => <span>{item}</span>)}</div></section>
      ))}
    </div>
  </Section>

  <Section title={copy.cv.learning}><LearningMap locale={locale} /></Section>
    </div>
  </details>
</BaseLayout>

<style>
  .web-cv { padding-top: 2px; }
  .web-cv summary { cursor: pointer; color: var(--blue); font-weight: 500; }
  .web-cv-content { padding-top: 24px; }
</style>
