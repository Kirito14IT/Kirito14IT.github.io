---
import { profile } from "@data/profile";
import NeuralField from "@components/NeuralField.astro";
---

<section class="hero-panel">
  <NeuralField />
  <div class="anime-stickers" aria-hidden="true">
    <span class="sticker sticker-1" data-draggable-sticker>AI</span>
    <span class="sticker sticker-2" data-draggable-sticker>SEC</span>
    <span class="sticker sticker-3" data-draggable-sticker>RL</span>
  </div>
  <div class="hero-kicker">
    <span></span>
    <strong>Research Focus</strong>
  </div>
  <h2>I am researching</h2>
  <div class="typing-line" aria-live="polite">
    <span class="typing-target" data-typing-words={JSON.stringify(profile.focusWords)}></span>
  </div>
  <p>{profile.tagline}</p>
  <div class="hero-actions">
    <a class="button primary" href="/projects/">View Projects</a>
    <a class="button ghost" href="/cv/">Open CV</a>
  </div>
</section>

<script>
  const typingTargets = document.querySelectorAll("[data-typing-words]");

  typingTargets.forEach((target) => {
    const raw = target.getAttribute("data-typing-words") || "[]";
    const words = JSON.parse(raw);
    let wordIndex = 0;
    let value = "";
    let deleting = false;

    const tick = () => {
      const current = words[wordIndex] || { text: "", color: "#2563eb" };
      const text = current.text;
      target.style.color = current.color;

      if (!deleting) {
        value = text.slice(0, value.length + 1);
        target.textContent = value;
        if (value === text) {
          deleting = true;
          window.setTimeout(tick, 1400);
          return;
        }
      } else {
        value = text.slice(0, Math.max(0, value.length - 1));
        target.textContent = value;
        if (value.length === 0) {
          deleting = false;
          wordIndex = (wordIndex + 1) % words.length;
        }
      }

      window.setTimeout(tick, deleting ? 42 : 86);
    };

    tick();
  });

  const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

  document.querySelectorAll("[data-draggable-sticker]").forEach((sticker) => {
    let dragState = null;

    const moveSticker = (event) => {
      if (!dragState) return;
      const heroRect = dragState.hero.getBoundingClientRect();
      const x = clamp(event.clientX - heroRect.left - dragState.offsetX, 18, heroRect.width - dragState.width - 18);
      const y = clamp(event.clientY - heroRect.top - dragState.offsetY, 18, heroRect.height - dragState.height - 18);
      sticker.style.left = `${x}px`;
      sticker.style.top = `${y}px`;
      sticker.style.right = "auto";
      sticker.style.bottom = "auto";
    };

    sticker.addEventListener("pointerdown", (event) => {
      const hero = sticker.closest(".hero-panel");
      if (!hero) return;
      const heroRect = hero.getBoundingClientRect();
      const stickerRect = sticker.getBoundingClientRect();
      dragState = {
        hero,
        offsetX: event.clientX - stickerRect.left,
        offsetY: event.clientY - stickerRect.top,
        width: stickerRect.width,
        height: stickerRect.height
      };
      sticker.classList.add("is-dragging");
      sticker.style.left = `${stickerRect.left - heroRect.left}px`;
      sticker.style.top = `${stickerRect.top - heroRect.top}px`;
      sticker.style.right = "auto";
      sticker.style.bottom = "auto";
      sticker.setPointerCapture(event.pointerId);
      moveSticker(event);
    });

    sticker.addEventListener("pointermove", moveSticker);

    sticker.addEventListener("pointerup", (event) => {
      dragState = null;
      sticker.classList.remove("is-dragging");
      if (sticker.hasPointerCapture(event.pointerId)) sticker.releasePointerCapture(event.pointerId);
    });

    sticker.addEventListener("pointercancel", () => {
      dragState = null;
      sticker.classList.remove("is-dragging");
    });
  });
</script>
