---
import type { Locale } from "@i18n/index";

const { locale } = Astro.props as { locale: Locale };
const zh = locale === "zh";
const dashboard = "https://mapmyvisitors.com/web/1c95g";
const widget = new URL("https://mapmyvisitors.com/map.js");
widget.search = new URLSearchParams({
  d: "Miw8Y3UKp7XPCrYF9jOIM4QCtDp0Xsl3diZ8V2GxW78",
  co: "0b1428",
  cl: "72b7cd",
  ct: "cbdcf3",
  cmo: "a78bfa",
  cmn: "2dd4bf",
  t: "tt",
  w: "a"
}).toString();
---

<section id="visitors" class="section-stack visitor-section" aria-labelledby="visitor-title" data-visitor-map data-widget-src={widget.toString()}>
  <div class="section-heading">
    <p>{zh ? "跨越山海的相遇" : "Connections across the world"}</p>
    <h2 id="visitor-title">{zh ? "世界访客" : "Visitors around the world"}</h2>
  </div>
  <div class="visitor-panel">
    <div class="visitor-header">
      <div class="visitor-label">
        <svg viewBox="0 0 32 32" width="30" height="30" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="10" stroke="currentColor" stroke-width="1.4" />
          <ellipse cx="16" cy="16" rx="4" ry="10" stroke="currentColor" stroke-width="1.2" />
          <path d="M6 16h20M8 10.5c5 3 11 3 16 0M8 21.5c5-3 11-3 16 0" stroke="currentColor" stroke-width="1.2" />
          <path d="M4 22c-3 0-2-5 3-10M25 9c6-2 7 1 2 6" stroke="#b69aff" stroke-width="1.4" stroke-linecap="round" />
        </svg>
        <span>GLOBAL VISITOR MAP</span>
      </div>
      <a class="visitor-details" href={dashboard} target="_blank" rel="noopener noreferrer">{zh ? "查看访问统计 ↗" : "Explore visitor stats ↗"}</a>
    </div>
    <div class="visitor-stage">
      <div class="visitor-status" data-visitor-status role="status">
        <svg viewBox="0 0 48 48" width="48" height="48" fill="none" aria-hidden="true"><circle cx="24" cy="24" r="19" stroke="currentColor" /><ellipse cx="24" cy="24" rx="8" ry="19" stroke="currentColor" /><path d="M5 24h38M9 13c9 5 21 5 30 0M9 35c9-5 21-5 30 0" stroke="currentColor" /></svg>
        <span data-visitor-message>{zh ? "启用 JavaScript 后显示访问地图，也可直接打开访问统计。" : "Enable JavaScript to display the map, or open the visitor statistics."}</span>
      </div>
      <div class="visitor-host" data-visitor-host></div>
    </div>
    <div class="visitor-caption">
      <span>{zh ? "访问位置基于 IP 估算，可能受代理或 VPN 影响。" : "Locations are estimated from IP addresses and may reflect a proxy or VPN."}</span>
      <a href="https://mapmyvisitors.com/b/policy" target="_blank" rel="noopener noreferrer">MapMyVisitors · {zh ? "隐私说明" : "Privacy"}</a>
    </div>
  </div>
</section>

<style>
  .visitor-panel {
    position: relative; isolation: isolate; overflow: hidden; border-radius: 28px;
    padding: 1px; border: 1px solid rgba(106, 158, 233, 0.35);
    background: #0b1428; color: #dbe9ff;
    box-shadow: 0 22px 65px rgba(16, 38, 80, 0.18), 0 0 30px rgba(76, 111, 240, 0.09);
  }
  .visitor-panel::before {
    content: ""; position: absolute; z-index: -1; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse at 0 0, #113b53 0, transparent 44%), radial-gradient(ellipse at 100% 0, #30204e 0, transparent 48%);
  }
  .visitor-header { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 26px 18px; }
  .visitor-label { display: inline-flex; align-items: center; gap: 12px; color: #79d6ee; font: 700 0.7rem var(--mono); letter-spacing: 0.09em; }
  .visitor-label svg { flex: none; filter: drop-shadow(0 0 7px #54d8ef55); }
  .visitor-details { color: #e7dcff; text-decoration: none; font-size: 0.76rem; padding: 7px 12px; border: 1px solid #ad8bf24d; border-radius: 9px; background: #b38df010; }
  .visitor-details:hover { color: #fff; border-color: #bca1f6; background: #b38df025; }
  .visitor-panel a:focus-visible { outline: 2px solid #80e7f6; outline-offset: 4px; }
  .visitor-stage { position: relative; margin: 0 18px; min-height: clamp(205px, 36vw, 430px); background: #0b1428; border-radius: 16px; }
  .visitor-host { width: 100%; }
  .visitor-status { position: absolute; inset: 0; display: grid; align-content: center; justify-items: center; gap: 18px; padding: 24px; text-align: center; font-size: 0.8rem; color: #a9bbd5; }
  .visitor-status svg { color: #72b7cd; opacity: 0.75; }
  .visitor-caption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 10px 20px; margin: 16px 26px 0; padding: 15px 0 18px; border-top: 1px solid #a5bdf51c; color: #94a8c4; font-size: 0.7rem; }
  .visitor-caption a { color: #b4c8e5; text-decoration: none; }
  .visitor-caption a:hover { text-decoration: underline; }
  .visitor-section :global(#mapmyvisitors-widget) { width: 100% !important; max-width: 100%; border-radius: 12px; overflow: hidden; }
  .visitor-section :global(.mapmyvisitors-map) { width: 100% !important; height: auto !important; aspect-ratio: 2.04; background-size: 100% 100%; }
  .visitor-section :global(.mapmyvisitors-visitors) { padding: 12px 0 5px; font-family: var(--mono); }
  .visitor-section :global(.mapmyvisitors-date) { opacity: 0.65; }
  .visitor-section :global(#mapmyvisitors-widget .jvectormap-zoomin), .visitor-section :global(#mapmyvisitors-widget .jvectormap-zoomout) { background: #203654; color: #c6f1ff; border-color: #72b7cd55; }
  [hidden] { display: none; }
  @media (max-width: 520px) {
    .visitor-header { padding: 18px 16px 14px; gap: 12px; }
    .visitor-label { font-size: 0.65rem; gap: 8px; }
    .visitor-stage { margin: 0 8px; }
    .visitor-caption { margin-inline: 16px; }
  }
</style>

<script>
  const section = document.querySelector<HTMLElement>("[data-visitor-map]");
  if (section) {
    const host = section.querySelector<HTMLElement>("[data-visitor-host]")!;
    const status = section.querySelector<HTMLElement>("[data-visitor-status]")!;
    const message = section.querySelector<HTMLElement>("[data-visitor-message]")!;
    const zh = document.documentElement.lang.startsWith("zh");

    if (location.hostname !== "kirito14it.github.io") {
      section.dataset.state = "preview";
      message.textContent = zh ? "本地预览不计入访问统计。上线后将显示真实访问地图。" : "Local previews are not tracked. The live site displays the real visitor map.";
    } else {
      section.dataset.state = "loading";
      message.textContent = zh ? "正在连接 MapMyVisitors…" : "Connecting to MapMyVisitors…";
      const unavailable = () => {
        section.dataset.state = "unavailable";
        host.hidden = true;
        message.textContent = zh ? "地图暂时无法加载，请使用上方链接查看统计。" : "The map is temporarily unavailable. Use the link above to view visitor statistics.";
      };
      const timeout = window.setTimeout(unavailable, 16000);
      const observer = new MutationObserver(() => {
        const link = host.querySelector<HTMLAnchorElement>("#mapmyvisitors-widget");
        const counter = host.querySelector(".mapmyvisitors-visitors");
        if (link) {
          link.href = "https://mapmyvisitors.com/web/1c95g";
          link.target = "_blank";
          link.rel = "noopener noreferrer";
          link.setAttribute("aria-label", zh ? "打开访客地图详细统计" : "Open detailed visitor map statistics");
        }
        if (!counter?.textContent?.trim() || !host.querySelector("svg")) return;
        section.dataset.state = "ready";
        status.hidden = true;
        host.hidden = false;
        window.clearTimeout(timeout);
        observer.disconnect();
        // Resize the provider's map without reloading its tracking script.
        const resize = new ResizeObserver(() => {
          type MapJQuery = (node: Element) => { data: (key: string) => { updateSize?: () => void } | undefined };
          const jq = (window as Window & { vmap_jq?: MapJQuery }).vmap_jq;
          const container = host.querySelector(".jvectormap-container");
          if (container) jq?.(container).data("mapObject")?.updateSize?.();
        });
        resize.observe(host);
      });
      observer.observe(host, { childList: true, subtree: true, characterData: true });
      const script = document.createElement("script");
      script.id = "mapmyvisitors";
      script.src = section.dataset.widgetSrc!;
      script.async = true;
      script.onerror = unavailable;
      host.append(script);
    }
  }
</script>
