---
import { execFileSync } from "node:child_process";
import { getProfile } from "@data/profile";
import { formatNumericDate } from "@i18n/date";
import { getUi, type Locale } from "@i18n/index";

const { showVisitCounter = false, locale } = Astro.props as { showVisitCounter?: boolean; locale: Locale };
const profile = getProfile(locale);
const copy = getUi(locale);

let updateSource = "git";
let updatedAtRaw = "";

try {
  updatedAtRaw = execFileSync("git", ["show", "-s", "--format=%cI", "HEAD"], {
    cwd: process.cwd(),
    encoding: "utf8"
  }).trim();
} catch {
  updateSource = "build";
  updatedAtRaw = new Date().toISOString();
}

let updatedAt = new Date(updatedAtRaw);
if (Number.isNaN(updatedAt.valueOf())) {
  updateSource = "build";
  updatedAt = new Date();
}

const updatedIso = updatedAt.toISOString();
const timeZone = "Asia/Shanghai";
const updatedLabel = formatNumericDate(updatedAt, { timeZone });
const updatedExactLabel = formatNumericDate(updatedAt, {
  hour: "2-digit",
  minute: "2-digit",
  timeZone,
  timeZoneName: "short"
});

const visitorBadgeUrl = new URL("https://api.visitorbadge.io/api/visitors");
visitorBadgeUrl.searchParams.set("path", profile.siteUrl);
visitorBadgeUrl.searchParams.set("label", copy.footer.visitsLabel);
visitorBadgeUrl.searchParams.set("labelColor", "#e8f6ff");
visitorBadgeUrl.searchParams.set("countColor", "#2563eb");
visitorBadgeUrl.searchParams.set("style", "flat");
visitorBadgeUrl.searchParams.set("labelStyle", "none");
---

<footer class="site-footer" data-site-footer>
  <p class="last-updated" data-last-updated data-update-source={updateSource}>
    <span class="footer-update-dot" aria-hidden="true"></span>
    <span>{copy.footer.updated}</span>
    <time datetime={updatedIso} title={updatedExactLabel}>{updatedLabel}</time>
  </p>

  {showVisitCounter && (
    <div class="visit-counter" data-visit-counter>
      <span id="homepage-visit-count" class="visit-count-value" data-visit-count-value>
        <img
          src={visitorBadgeUrl.toString()}
          alt={copy.footer.visitsAlt}
          width={locale === "en" ? 182 : 76}
          height="20"
          loading="eager"
          fetchpriority="low"
          referrerpolicy="no-referrer"
          data-visit-badge
        />
        <span class="visit-count-fallback" hidden data-visit-fallback>{copy.footer.unavailable}</span>
      </span>
    </div>
  )}
</footer>

{showVisitCounter && (
  <script>
    document.querySelectorAll<HTMLElement>("[data-visit-counter]").forEach((counter) => {
      const badge = counter.querySelector<HTMLImageElement>("[data-visit-badge]");
      const fallback = counter.querySelector<HTMLElement>("[data-visit-fallback]");

      if (!badge) return;
      const showFallback = () => {
        badge.hidden = true;
        if (fallback) fallback.hidden = false;
      };
      badge.addEventListener("error", showFallback);
      if (badge.complete && badge.naturalWidth === 0) showFallback();
    });
  </script>
)}
